    {
      "id": "default",
      "text": "Atolye her zaman acik. Yeni gelenler genelde once isimlerini duyurur, sonra ekip kurmaya baslar.",
      "choices": [
        {
          "id": "selin-default-close",
          "text": "Anladim",
          "close": true
        }
      ]
    },
    {
      "id": "workshop-locked",
      "text": "Toren'in anahtar isini bitirince bana gel. Atolyede o zaman bir seyler acariz.",
      "choices": [
        {
          "id": "selin-locked-close",
          "text": "Tamam",
          "close": true
        }
      ]
    },
    {
      "id": "workshop-offer",
      "text": "Workshop yanindaki sandigi anahtarla ac. Icindekileri getirirsen sana 40 coin ve bir hediye kutusu verecegim.",
      "choices": [
        {
          "id": "selin-accept-workshop",
          "text": "Sandigi acacagim",
          "action": {
            "type": "start-quest",
            "questId": "open-workshop-chest"
          },
          "nextNodeId": "workshop-accepted"
        },
        {
          "id": "selin-decline-workshop",
          "text": "Birazdan donecegim",
          "close": true
        }
      ]
    },
    {
      "id": "workshop-accepted",
      "text": "Sandik workshop'un yaninda duruyor. Anahtar sende olmali. Isi bitirince odul seni bekleyecek.",
      "choices": [
        {
          "id": "selin-accepted-close",
          "text": "Hemen gidiyorum",
          "close": true
        }
      ]
    },
    {
      "id": "workshop-progress",
      "text": "Sandik workshop'un yaninda duruyor. Anahtar sende olmali.",

          "text": "Birazdan bakarim",
          "close": true
        }
      ]
    },
    {
      "id": "visit-accepted",
      "text": "Harika. Cesmeye bir kez ugraman yeterli, sonra yolunu bulmak daha kolay gelecek.",
      "choices": [
        {
          "id": "mira-accepted-close",
          "text": "Yola cikiyorum",
          "close": true
        }
      ]
    },
    {
      "id": "visit-progress",
      "text": "Cesme hemen meydanin ortasinda. Oraya gidip kasabanin akisini gor.",

    {
      "id": "default",
      "text": "Pazar yeni kuruldu. Aksam olmadan lonca meydanina da ugrarsan herkesle tanisirsin.",
      "choices": [
        {
          "id": "mira-default-close",
          "text": "Tesekkurler",
          "close": true
        }
      ]
    },
    {
      "id": "visit-offer",
      "text": "Kasaba meydanindaki cesmeye git. Orasi herkesin bulusma noktasi. Donunce sana 25 coin verecegim.",
      "choices": [
        {
          "id": "mira-accept-visit",
          "text": "Gorevi aliyorum",
          "action": {
            "type": "start-quest",
            "questId": "visit-fountain"
          },
          "nextNodeId": "visit-accepted"
        },
        {

          "close": true
        }
      ]
    },
    {
      "id": "visit-complete",
      "text": "Meydan yolunu ogrendin. Simdi istersen Moon Cafe'ye ugrayip ilk kahveni alip kasabanin sosyal akisini gorebilirsin.",
      "choices": [
        {
          "id": "mira-complete-close",
          "text": "Devam edelim",
          "close": true
        }

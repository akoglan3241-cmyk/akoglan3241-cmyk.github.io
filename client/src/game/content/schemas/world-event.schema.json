{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World Events",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "type", "roomId", "title", "announcement", "durationMs", "weight"],
    "properties": {
      "id": { "type": "string" },
      "type": { "type": "string", "enum": ["bonus-chest", "rare-collectible", "npc-festival"] },
      "roomId": { "type": "string" },
      "title": { "type": "string" },
      "announcement": { "type": "string" },
      "durationMs": { "type": "number", "minimum": 1 },
      "weight": { "type": "number", "minimum": 1 }
    }
  }
}

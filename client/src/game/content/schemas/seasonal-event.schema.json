{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seasonal Events",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "bannerLabel", "announcement", "startMonthDay", "endMonthDay", "roomIds"],
    "properties": {
      "id": { "type": "string" },
      "title": { "type": "string" },
      "bannerLabel": { "type": "string" },
      "announcement": { "type": "string" },
      "startMonthDay": { "type": "string" },
      "endMonthDay": { "type": "string" },
      "roomIds": { "type": "array", "items": { "type": "string" } }
    }
  }
}
